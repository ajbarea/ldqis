---
// Shared site navigation: logo, section links, News, theme toggle, and an
// optional contextual back-link. Below the md breakpoint the section links
// collapse into a hamburger dropdown so mobile keeps full navigation (the
// theme-toggle script lived only in index.astro before this component).
interface Props {
  back?: { href: string; label: string };
}
const { back } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  { href: `${base}/#research`, label: "Research" },
  { href: `${base}/#projects`, label: "Projects" },
  { href: `${base}/#publications`, label: "Publications" },
  { href: `${base}/#people`, label: "People" },
  { href: `${base}/news/`, label: "News" },
];
---

<nav
  class="sticky top-0 z-50 border-b border-line backdrop-blur-md"
  style="background: color-mix(in oklab, var(--color-bg) 78%, transparent);"
  aria-label="Site"
>
  <div class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-[18px]">
    <a
      href={import.meta.env.BASE_URL}
      class="flex items-center gap-[10px]"
      style="font-family: var(--font-display); font-size: 26px; letter-spacing: -0.5px;"
    >
      <span
        class="relative h-7 w-7 rounded-lg"
        style="background: linear-gradient(135deg, var(--color-rit-orange), var(--color-rit-yellow));"
      >
        <span
          class="absolute inset-[6px] rounded-[4px] border-[1.5px]"
          style="border-color: color-mix(in oklab, var(--color-bg) 92%, transparent); border-bottom: none; border-right: none;"
        ></span>
      </span>
      LDQIS
    </a>

    <div class="flex items-center gap-5 md:gap-7">
      <div class="hidden items-center gap-7 text-sm text-text-dim md:flex">
        {
          links.map((l) => (
            <a href={l.href} class="hover:text-text">
              {l.label}
            </a>
          ))
        }
        {
          back && (
            <a href={back.href} class="whitespace-nowrap hover:text-rit-orange-text">
              {back.label}
            </a>
          )
        }
      </div>

      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle color theme"
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-text-dim transition-transform hover:rotate-[15deg] hover:border-rit-orange hover:text-rit-orange-text"
      >
        <svg
          class="h-4 w-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg
          class="hidden h-4 w-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
          ></path>
        </svg>
      </button>

      <button
        type="button"
        id="nav-menu-btn"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-text-dim hover:border-rit-orange hover:text-rit-orange-text md:hidden"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line md:hidden">
    <div class="mx-auto flex max-w-[1200px] flex-col px-6 py-2 text-sm text-text-dim">
      {
        links.map((l) => (
          <a href={l.href} class="py-2 hover:text-text">
            {l.label}
          </a>
        ))
      }
      {
        back && (
          <a href={back.href} class="py-2 hover:text-rit-orange-text">
            {back.label}
          </a>
        )
      }
    </div>
  </div>
</nav>

<script>
  const root = document.documentElement;
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    if (next === "light") root.removeAttribute("data-theme");
    else root.setAttribute("data-theme", "dark");
    try {
      localStorage.setItem("ldqis-theme", next);
    } catch {
      /* localStorage blocked — toggle is in-memory only this session */
    }
  });

  const menuBtn = document.getElementById("nav-menu-btn");
  const menu = document.getElementById("mobile-menu");
  menuBtn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    menuBtn.setAttribute("aria-expanded", String(open));
  });
</script>
