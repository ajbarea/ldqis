---
// Shared site navigation: logo, section links, News, theme toggle, and an
// optional contextual back-link. Below the md breakpoint the section links
// collapse into a hamburger dropdown so mobile keeps full navigation (the
// theme-toggle script lived only in index.astro before this component).
import { basePath, primaryLinks } from "../lib/site-links";

interface Props {
  back?: { href: string; label: string };
}
const { back } = Astro.props;
const links = primaryLinks(import.meta.env.BASE_URL);
// Pagefind writes its bundle to dist/pagefind/ at build time (`npm run build`).
const pagefind = `${basePath(import.meta.env.BASE_URL)}/pagefind`;
---

<nav
  class="sticky top-0 z-50 border-b border-line backdrop-blur-md"
  style="background: color-mix(in oklab, var(--color-bg) 78%, transparent);"
  aria-label="Site"
>
  <div class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-[18px]">
    <a
      href={import.meta.env.BASE_URL}
      class="flex items-center gap-[10px]"
      style="font-family: var(--font-display); font-size: 26px; letter-spacing: -0.5px;"
    >
      <span
        class="relative h-7 w-7 rounded-lg"
        style="background: linear-gradient(135deg, var(--color-rit-orange), var(--color-rit-yellow));"
      >
        <span
          class="absolute inset-[6px] rounded-[4px] border-[1.5px]"
          style="border-color: color-mix(in oklab, var(--color-bg) 92%, transparent); border-bottom: none; border-right: none;"
        ></span>
      </span>
      LDQIS
    </a>

    <div class="flex items-center gap-5 md:gap-7">
      <div class="hidden items-center gap-7 text-sm text-text-dim md:flex">
        {links.map((l) => (
          <a href={l.href} class="hover:text-text">
            {l.label}
          </a>
        ))}
        {back && (
          <a href={back.href} class="whitespace-nowrap hover:text-rit-orange-text">
            {back.label}
          </a>
        )}
      </div>

      <button
        type="button"
        id="search-btn"
        aria-label="Search"
        aria-haspopup="dialog"
        aria-expanded="false"
        data-src={`${pagefind}/pagefind-component-ui.js`}
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line bg-transparent text-text-dim hover:border-rit-orange hover:text-rit-orange-text"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>

      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle color theme"
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-text-dim transition-transform hover:rotate-[15deg] hover:border-rit-orange hover:text-rit-orange-text"
      >
        <svg
          class="h-4 w-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg
          class="hidden h-4 w-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
      </button>

      <button
        type="button"
        id="nav-menu-btn"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-text-dim hover:border-rit-orange hover:text-rit-orange-text md:hidden"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <p
    id="search-status"
    role="status"
    class="absolute top-full right-6 mt-2 rounded-md border border-line bg-bg-elev px-3 py-2 text-xs text-text empty:sr-only"
  ></p>

  <div id="mobile-menu" class="hidden border-t border-line md:hidden">
    <div class="mx-auto flex max-w-[1200px] flex-col px-6 py-2 text-sm text-text-dim">
      {links.map((l) => (
        <a href={l.href} class="py-2 hover:text-text">
          {l.label}
        </a>
      ))}
      {back && (
        <a href={back.href} class="py-2 hover:text-rit-orange-text">
          {back.label}
        </a>
      )}
    </div>
  </div>
</nav>

<pagefind-config bundle-path={`${pagefind}/`} base-url={import.meta.env.BASE_URL}></pagefind-config>
<pagefind-modal reset-on-close data-pagefind-ignore></pagefind-modal>

<script>
  const root = document.documentElement;
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    if (next === "light") root.removeAttribute("data-theme");
    else root.setAttribute("data-theme", "dark");
    try {
      localStorage.setItem("ldqis-theme", next);
    } catch {
      /* localStorage blocked — toggle is in-memory only this session */
    }
  });

  const menuBtn = document.getElementById("nav-menu-btn");
  const menu = document.getElementById("mobile-menu");
  menuBtn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    menuBtn.setAttribute("aria-expanded", String(open));
  });

  // research(2026-10): the Pagefind UI (175 KB JS, 41 KB CSS) loads on first use (click,
  // hover, focus, or the shortcut), not on every page view.
  const searchBtn = document.getElementById("search-btn")!;
  const status = document.getElementById("search-status")!;
  const modal = document.querySelector<
    HTMLElement & { open(): void; dialogEl?: HTMLDialogElement }
  >("pagefind-modal");
  const jsSrc = searchBtn.dataset.src!;
  const mac = /Mac|iPhone|iPad/.test(
    (navigator as Navigator & { userAgentData?: { platform: string } }).userAgentData?.platform ??
      navigator.platform,
  );
  searchBtn.setAttribute("aria-keyshortcuts", mac ? "Meta+K" : "Control+K");

  // The CSS and JS are tracked apart: a retry re-adds only the one that failed, and search
  // is ready once both have loaded. A failed module fetch stays cached for the page, so a
  // retried script gets a fresh ?retry=N URL.
  type Asset = {
    ok: boolean;
    tries: number;
    pending?: Promise<void>;
    make: (n: number) => Element;
  };
  const css: Asset = {
    ok: false,
    tries: 0,
    make: () =>
      Object.assign(document.createElement("link"), {
        rel: "stylesheet",
        href: jsSrc.replace(/\.js$/, ".css"),
      }),
  };
  const js: Asset = {
    ok: false,
    tries: 0,
    make: (n) =>
      Object.assign(document.createElement("script"), {
        type: "module",
        src: n ? `${jsSrc}?retry=${n}` : jsSrc,
      }),
  };
  const readyWaiters: (() => void)[] = [];
  const ready = () => css.ok && js.ok && !!modal?.dialogEl;
  const add = (a: Asset) =>
    a.ok
      ? Promise.resolve()
      : (a.pending ??= new Promise<void>((resolve, reject) => {
          const el = a.make(a.tries++) as HTMLScriptElement & HTMLLinkElement;
          el.onload = () => {
            a.ok = true;
            a.pending = undefined;
            resolve();
            // Defining the element upgrades <pagefind-modal> in place and builds its dialog.
            if (ready()) readyWaiters.splice(0).forEach((r) => r());
          };
          el.onerror = () => {
            el.remove();
            a.pending = undefined;
            reject(new Error("search bundle unavailable"));
          };
          document.head.append(el);
        }));
  const load = () => Promise.all([add(css), add(js)]);
  // Resolves when any attempt completes, so an abandoned attempt that finishes still wins.
  const whenReady = () => new Promise<void>((r) => (ready() ? r() : readyWaiters.push(r)));

  // Any click, key or focus change after a request means the user moved on.
  let epoch = 0;
  for (const ev of ["click", "keydown", "focusin"])
    document.addEventListener(ev, () => void epoch++, true);

  let statusTimer: number | undefined;
  const say = (text: string, clearAfter = 0) => {
    clearTimeout(statusTimer);
    status.textContent = text;
    if (clearAfter) statusTimer = window.setTimeout(() => (status.textContent = ""), clearAfter);
  };
  const openSearch = async () => {
    const mine = epoch;
    if (!ready()) say("Loading search…");
    // Past the deadline the old attempts keep running, but the next request starts fresh ones.
    const deadline = setTimeout(() => {
      css.pending = undefined;
      js.pending = undefined;
      say("Search is taking longer than usual. Select it again to retry.");
    }, 10_000);
    try {
      await Promise.race([load(), whenReady()]);
    } catch {
      say("Search is unavailable. Try again.", 5000);
      return;
    } finally {
      clearTimeout(deadline);
    }
    say("");
    if (epoch !== mine) return;
    modal?.open();
    searchBtn.setAttribute("aria-expanded", "true");
  };
  modal?.addEventListener("close", () => searchBtn.setAttribute("aria-expanded", "false"), true);
  for (const ev of ["pointerenter", "focus"] as const)
    searchBtn.addEventListener(ev, () => void load().catch(() => {}), { once: true });
  searchBtn.addEventListener("click", () => void openSearch());
  document.addEventListener("keydown", (e) => {
    if (typeof e.key !== "string" || e.key.toLowerCase() !== "k") return;
    // macOS: Cmd+K only, so Ctrl+K (kill-line) still works in text fields.
    if (mac ? !e.metaKey || e.ctrlKey : !e.ctrlKey || e.metaKey) return;
    if (e.altKey || e.shiftKey) return;
    const t = e.target as HTMLElement | null;
    if (t?.closest("input, textarea, select, [contenteditable]")) return;
    e.preventDefault();
    void openSearch();
  });
  // Dev has no index until a build: hide the button rather than offer a dead control.
  if (import.meta.env.DEV)
    fetch(jsSrc, { method: "HEAD" }).then(
      (r) => r.ok || searchBtn.setAttribute("hidden", ""),
      () => searchBtn.setAttribute("hidden", ""),
    );
</script>
