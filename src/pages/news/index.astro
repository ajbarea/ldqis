---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

// Hide drafts AND future-dated posts; mirror the same filter the RSS feed
// uses so the index and feed stay in sync.
const now = Date.now();
const posts = (await getCollection("news"))
  .filter((post) => !post.data.draft && post.data.pubDate.getTime() <= now)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
---

<BaseLayout
  title="News · LDQIS"
  description="News from the Laboratory of Data Quality and Intelligent Security at RIT — research updates, releases, and lab events."
>
  <nav
    class="sticky top-0 z-50 border-b border-line backdrop-blur-md"
    style="background: color-mix(in oklab, var(--color-bg) 78%, transparent);"
    aria-label="Site"
  >
    <div class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-[18px]">
      <a
        href={base + "/"}
        class="flex items-center gap-[10px]"
        style="font-family: var(--font-display); font-size: 26px; letter-spacing: -0.5px;"
      >
        <span
          class="h-7 w-7 rounded-lg"
          style="background: linear-gradient(135deg, var(--color-rit-orange), var(--color-rit-yellow));"
        ></span>
        LDQIS
      </a>
      <a href={base + "/"} class="text-sm text-text-dim hover:text-rit-orange-text"> ← Home </a>
    </div>
  </nav>

  <main id="main" class="relative z-[1] pt-16 pb-32">
    <header class="mx-auto max-w-[800px] px-6 pb-12">
      <div class="mb-4 text-xs tracking-[1.5px] text-rit-orange-text uppercase">News</div>
      <h1
        class="mb-4"
        style="font-family: var(--font-display); font-size: clamp(40px, 6vw, 64px); line-height: 1.05; letter-spacing: -1px;"
      >
        Notes from the lab.
      </h1>
      <p class="text-lg text-text-dim">
        Research updates, releases, and lab events. Subscribe via
        <a
          href={base + "/news/rss.xml"}
          class="border-b"
          style="color: var(--color-rit-orange-text); border-color: color-mix(in oklab, var(--color-rit-orange) 25%, transparent);"
          >RSS</a
        >.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="mx-auto max-w-[800px] px-6 text-text-dim italic">
          No posts yet. Check back soon, or subscribe via RSS.
        </p>
      ) : (
        <ol class="mx-auto flex max-w-[800px] flex-col gap-6 px-6">
          {posts.map((post) => (
            <li class="rounded-[14px] border border-line bg-bg-elev p-8 transition-colors hover:border-rit-orange">
              <time
                datetime={post.data.pubDate.toISOString()}
                class="mb-3 block text-xs tracking-[1.5px] text-text-faint uppercase"
              >
                {dateFmt.format(post.data.pubDate)}
              </time>
              <h2
                class="mb-3 text-2xl leading-tight"
                style="font-family: var(--font-display); letter-spacing: -0.5px;"
              >
                <a href={`${base}/news/${post.id}/`} class="hover:text-rit-orange-text">
                  {post.data.title}
                </a>
              </h2>
              <p class="mb-4 text-[15px] text-text-dim">{post.data.summary}</p>
              {post.data.tags.length > 0 && (
                <ul class="flex flex-wrap gap-2">
                  {post.data.tags.map((t) => (
                    <li
                      class="rounded-full border px-[10px] py-[3px] text-[11px] tracking-[1px] uppercase"
                      style="color: var(--color-rit-orange-text); background: color-mix(in oklab, var(--color-rit-orange) 8%, transparent); border-color: color-mix(in oklab, var(--color-rit-orange) 8%, transparent);"
                    >
                      {t}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>
      )
    }
  </main>
</BaseLayout>
