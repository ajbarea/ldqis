---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ContactLinks from "../components/ContactLinks.astro";
import Avatar from "../components/Avatar.astro";
import Nav from "../components/Nav.astro";
import { byRecency } from "../lib/publications";

// research(2026-05): projects / publications / people live in Astro content
// collections. The remaining inline `researchAreas` array stays
// here — it's short structural copy that lives with the homepage section,
// not the per-detail-page surface the collections target. See
// `src/content.config.ts` for collection schemas. Sources:
// https://docs.astro.build/en/guides/content-collections/
// https://docs.astro.build/en/reference/content-loader-reference/

const researchAreas = [
  {
    n: "01",
    title: "Federated Learning",
    desc: "Privacy-preserving model training across distributed clients — designing protocols, aggregation strategies, and threat models for collaborative ML without centralizing sensitive data.",
  },
  {
    n: "02",
    title: "Data Quality at Scale",
    desc: "Provable quality metrics for streaming sensor data, with frameworks for evaluating fitness-for-purpose across heterogeneous sources.",
  },
  {
    n: "03",
    title: "ML System Security",
    desc: "Adversarial robustness, model integrity, and runtime monitoring for ML systems deployed in safety-critical environments.",
  },
  {
    n: "04",
    title: "Edge Intelligence",
    desc: "Neural network architectures and inference systems designed for the power, privacy, and reliability constraints of edge deployment.",
  },
  {
    n: "05",
    title: "Verifiable Mobile Security",
    desc: "Building on the lab's shipped Android apps — Android System Security Evaluation and Detector of Unverified Apps on Google Play — into continuous verification for app supply-chain integrity.",
  },
  {
    n: "06",
    title: "Open-Source Tooling",
    desc: "Releasing reproducible benchmarks, evaluation frameworks, and reference implementations the community can build on.",
  },
];

const projectEntries = await getCollection("projects");
const projects = projectEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ ...entry.data, id: entry.id }));

const publicationEntries = await getCollection("publications");
const publications = publicationEntries
  .sort(byRecency)
  .map((entry) => ({ ...entry.data, id: entry.id }));

const peopleEntries = await getCollection("people");
const currentTeam = peopleEntries
  .filter((entry) => entry.data.cohort === "current")
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ ...entry.data, id: entry.id }));
const pastCohort = peopleEntries
  .filter((entry) => entry.data.cohort === "past")
  // Alumni sort alphabetically by name (leading honorific ignored), so a new
  // graduate slots in by name instead of inheriting an arbitrary `order`.
  .sort((a, b) =>
    a.data.name
      .replace(/^(Dr|Prof)\.?\s+/i, "")
      .localeCompare(b.data.name.replace(/^(Dr|Prof)\.?\s+/i, "")),
  )
  .map((entry) => ({ ...entry.data, id: entry.id }));
---

<BaseLayout>
  {/* NAV */}
  <Nav />

  <main id="main" class="relative z-[1]">
    {/* HERO */}
    <header class="relative pt-[120px] pb-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <div
          class="mb-8 inline-flex items-center gap-2 rounded-full border border-line bg-bg-soft px-3 py-[6px] text-xs text-text-dim"
        >
          <span
            class="h-[6px] w-[6px] rounded-full bg-rit-orange"
            style="box-shadow: 0 0 12px var(--color-rit-orange);"></span>
          Rochester Institute of Technology · Department of Computer Science
        </div>
        <h1
          class="mb-7 max-w-[14ch]"
          style="font-family: var(--font-display); font-size: clamp(48px, 8vw, 96px); font-weight: 400; line-height: 1.02; letter-spacing: -2px;"
        >
          Trustworthy data.<br /><em class="italic" style="color: var(--color-rit-orange);"
            >Intelligent</em
          > security.
        </h1>
        <p class="mb-10 max-w-[56ch] text-lg text-text-dim">
          The Laboratory of Data Quality and Intelligent Security at RIT builds the methods, models,
          and systems that make modern data infrastructure verifiable, resilient, and worthy of
          trust — from sensor networks at the edge to large-scale ML systems at the core.
        </p>
        <div class="flex flex-wrap gap-[14px]">
          <a
            href="#research"
            class="inline-flex items-center gap-2 rounded-full px-[22px] py-[14px] text-sm font-medium transition-transform hover:-translate-y-[1px]"
            style="background: var(--color-rit-orange); color: #0a0e13;"
          >
            Explore the research →
          </a>
          <a
            href="#support"
            class="inline-flex items-center gap-2 rounded-full border border-line px-[22px] py-[14px] text-sm font-medium text-text hover:border-text-dim"
          >
            Support our work
          </a>
        </div>

        {/* STATS */}
        <div
          class="mt-20 grid grid-cols-2 gap-px overflow-hidden rounded-[14px] border border-line md:grid-cols-4"
          style="background: var(--color-line);"
        >
          {
            [
              { num: "4", label: "Active OSS projects" },
              { num: "25+", label: "Researchers trained" },
              { num: "3", label: "Peer-reviewed publications" },
              { num: "12+", label: "Years of funded work" },
            ].map(({ num, label }) => (
              <div class="bg-bg px-6 py-7">
                <div style="font-family: var(--font-display); font-size: 44px; line-height: 1; color: var(--color-rit-orange);">
                  {num}
                </div>
                <div class="mt-[6px] text-[13px] tracking-[0.5px] text-text-dim uppercase">
                  {label}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </header>

    {/* RESEARCH AREAS */}
    <section id="research" class="relative py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-4 text-xs tracking-[1.5px] text-rit-orange-text uppercase">
          Research Areas
        </div>
        <h2
          class="mb-6 max-w-[22ch]"
          style="font-family: var(--font-display); font-size: clamp(36px, 5vw, 56px); line-height: 1.05; letter-spacing: -1px; text-wrap: balance;"
        >
          Six frontiers we're pushing in parallel.
        </h2>
        <p class="mb-14 max-w-[64ch] text-lg text-text-dim">
          Our work sits at the intersection of data quality, security, and intelligent systems —
          with a hard focus on what's deployable, measurable, and trustworthy.
        </p>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            researchAreas.map((area) => (
              <article class="rounded-[14px] border border-line bg-bg-elev p-8 transition-all hover:-translate-y-[2px] hover:border-rit-orange">
                <span
                  class="mb-6 block text-sm italic"
                  style="font-family: var(--font-display); color: var(--color-rit-orange-text);"
                >
                  — {area.n}
                </span>
                <div class="mb-3 text-[22px] leading-[1.2] font-medium">{area.title}</div>
                <p class="text-[15px] text-text-dim">{area.desc}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* PROJECTS */}
    <section id="projects" class="relative py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-4 text-xs tracking-[1.5px] text-rit-orange-text uppercase">
          Active Projects
        </div>
        <h2
          class="mb-6 max-w-[22ch]"
          style="font-family: var(--font-display); font-size: clamp(36px, 5vw, 56px); line-height: 1.05; letter-spacing: -1px; text-wrap: balance;"
        >
          What we're shipping right now.
        </h2>
        <p class="mb-14 max-w-[64ch] text-lg text-text-dim">
          Open-source frameworks, peer-reviewed methods, and end-to-end systems — built by the
          current cohort and used by researchers beyond LDQIS.
        </p>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {
            projects.map((p) => (
              <article class="flex flex-col rounded-[14px] border border-line bg-bg-elev p-8 transition-all hover:-translate-y-[2px] hover:border-rit-orange">
                <div class="mb-2 flex flex-wrap items-center gap-3">
                  {p.tags.map((t) => (
                    <span
                      class="rounded-full border px-[10px] py-[3px] text-[11px] tracking-[1px] uppercase"
                      style="color: var(--color-rit-orange-text); background: color-mix(in oklab, var(--color-rit-orange) 8%, transparent); border-color: color-mix(in oklab, var(--color-rit-orange) 8%, transparent);"
                    >
                      {t}
                    </span>
                  ))}
                </div>
                <div class="mb-[18px] font-mono text-[11px] text-text-faint">
                  {p.stack.join(" · ")}
                </div>
                <div
                  class="mb-[6px] leading-[1.1]"
                  style="font-family: var(--font-display); font-size: 28px; letter-spacing: -0.5px;"
                >
                  {p.name}
                </div>
                <div class="mb-4 text-sm text-text-dim italic">{p.tagline}</div>
                <p class="mb-6 flex-grow text-[15px] text-text-dim" set:html={p.desc} />
                <div class="flex flex-wrap gap-[14px] border-t border-line pt-[18px] text-[13px]">
                  {p.links.map((l) => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center gap-1 hover:underline"
                      style="color: var(--color-rit-orange-text);"
                    >
                      {l.label}
                    </a>
                  ))}
                  <a
                    href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/projects/${p.id}/`}
                    class="ml-auto inline-flex items-center gap-1 text-text-dim hover:text-rit-orange-text"
                    aria-label={`Project page for ${p.name}`}
                  >
                    Project page →
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* PUBLICATIONS */}
    <section id="publications" class="relative py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-4 text-xs tracking-[1.5px] text-rit-orange-text uppercase">Publications</div>
        <h2
          class="mb-6 max-w-[22ch]"
          style="font-family: var(--font-display); font-size: clamp(36px, 5vw, 56px); line-height: 1.05; letter-spacing: -1px; text-wrap: balance;"
        >
          Recent peer-reviewed work.
        </h2>
        <p class="mb-14 max-w-[64ch] text-lg text-text-dim">
          Selected recent publications from the lab. For the complete record, see Dr. Reznik's
          <a
            href="https://scholar.google.com/citations?user=cKqeJEgAAAAJ&hl=en"
            target="_blank"
            rel="noopener"
            class="border-b"
            style="color: var(--color-rit-orange-text); border-color: color-mix(in oklab, var(--color-rit-orange) 8%, transparent);"
            >Google Scholar profile</a
          >.
        </p>
        <div class="flex flex-col gap-4">
          {
            publications.map((pub) => (
              <article class="grid grid-cols-1 items-center gap-6 rounded-[14px] border border-line bg-bg-elev p-6 hover:border-rit-orange md:grid-cols-[auto_1fr_auto] md:px-7">
                <div
                  class="text-4xl leading-none"
                  style="font-family: var(--font-display); color: var(--color-rit-orange-text); letter-spacing: -1px;"
                >
                  {pub.year}
                </div>
                <div class="min-w-0">
                  <div class="mb-[6px] text-[11px] tracking-[1.5px] text-text-faint uppercase">
                    {pub.venue}
                  </div>
                  <a
                    href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/publications/${pub.id}/`}
                    class="mb-1 inline-block text-[17px] leading-[1.35] font-medium hover:text-rit-orange-text"
                  >
                    {pub.title}
                  </a>
                  <div class="text-[13px] text-text-dim">{pub.authors}</div>
                </div>
                <a
                  href={pub.link.href}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-[6px] justify-self-start rounded-full border border-line px-[14px] py-2 text-[13px] whitespace-nowrap text-text-dim hover:border-rit-orange hover:text-rit-orange-text md:justify-self-auto"
                >
                  {pub.link.label}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* PEOPLE */}
    <section
      id="people"
      class="relative py-[100px]"
      style="background: var(--color-bg-elev); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line);"
    >
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-4 text-xs tracking-[1.5px] text-rit-orange-text uppercase">People</div>
        <h2
          class="mb-6 max-w-[22ch]"
          style="font-family: var(--font-display); font-size: clamp(36px, 5vw, 56px); line-height: 1.05; letter-spacing: -1px; text-wrap: balance;"
        >
          The team — past and present.
        </h2>
        <p class="mb-14 max-w-[64ch] text-lg text-text-dim">
          LDQIS is the work of every researcher who has passed through it. Today's team is pushing
          on federated learning and agentic AI; previous cohorts built the foundations in mobile
          security, data quality evaluation, wearable sensors, and computational intelligence that
          made today's work possible.
        </p>

        <div class="mb-6 flex items-baseline gap-4">
          <span
            class="text-[11px] tracking-[1.5px] uppercase"
            style="color: var(--color-rit-orange-text);">Now</span
          >
          <h3
            class="font-normal"
            style="font-family: var(--font-display); font-size: 28px; letter-spacing: -0.5px;"
          >
            Current Team
          </h3>
          <span class="text-[13px] text-text-dim">Federated learning · Agentic AI</span>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-4">
          {
            currentTeam.map((p) => (
              <div
                class={`rounded-[14px] border border-line bg-bg-elev p-6 transition-colors hover:border-rit-orange ${p.lead ? "sm:col-span-2 md:col-span-2" : ""}`}
                style={
                  p.lead
                    ? "background: linear-gradient(135deg, var(--color-bg-elev), var(--color-bg-soft));"
                    : undefined
                }
              >
                <div class="mb-4 flex items-center gap-3">
                  <Avatar
                    avatar={p.avatar}
                    github={p.github}
                    initials={p.initials}
                    name={p.name}
                    transitionName={`avatar-${p.id}`}
                  />
                  <a
                    href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/people/${p.id}/`}
                    class="inline-block text-base font-medium hover:text-rit-orange-text"
                  >
                    {p.name}
                  </a>
                </div>
                <div class="text-[13px] text-text-dim">{p.role}</div>
                {p.years && <div class="mt-1 text-xs text-text-dim">{p.years}</div>}
                <ContactLinks
                  email={p.email}
                  scholar={p.scholar}
                  ieee={p.ieee}
                  website={p.website}
                  github={p.github}
                  linkedin={p.linkedin}
                  youtube={p.youtube}
                  orcid={p.orcid}
                  name={p.name}
                />
              </div>
            ))
          }
        </div>

        <div class="mt-14 mb-6 flex items-baseline gap-4 border-t border-line pt-4">
          <span
            class="text-[11px] tracking-[1.5px] uppercase"
            style="color: var(--color-rit-orange-text);">Then</span
          >
          <h3
            class="font-normal"
            style="font-family: var(--font-display); font-size: 28px; letter-spacing: -0.5px;"
          >
            Past Research Cohort
          </h3>
          <span class="text-[13px] text-text-dim"
            >Mobile security · Android attacks · Wearable sensors · Data quality · Computational
            intelligence</span
          >
        </div>

        <p class="mb-8 max-w-[64ch] text-sm text-text-dim">
          These researchers led work that remains foundational to LDQIS today, including our Android
          security apps, the NSF Data Quality &amp; Security Evaluation Framework, and the
          wearable-sensors and computational-intelligence research lines that preceded today's
          federated learning work.
        </p>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-4">
          {
            pastCohort.map((p) => (
              <div class="rounded-[14px] border border-line bg-bg-elev p-6 transition-colors hover:border-rit-orange">
                <div class="mb-4 flex items-center gap-3">
                  <Avatar
                    avatar={p.avatar}
                    github={p.github}
                    initials={p.initials}
                    name={p.name}
                    transitionName={`avatar-${p.id}`}
                  />
                  <a
                    href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/people/${p.id}/`}
                    class="inline-block text-base font-medium hover:text-rit-orange-text"
                  >
                    {p.name}
                  </a>
                </div>
                <div class="text-[13px] text-text-dim">{p.role}</div>
                {p.years && <div class="mt-1 text-xs text-text-dim">{p.years}</div>}
                <ContactLinks
                  email={p.email}
                  scholar={p.scholar}
                  ieee={p.ieee}
                  website={p.website}
                  github={p.github}
                  linkedin={p.linkedin}
                  youtube={p.youtube}
                  orcid={p.orcid}
                  name={p.name}
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* GET INVOLVED */}
    <section id="support" class="relative py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <div
          class="relative overflow-hidden rounded-[14px] border border-line px-12 py-16 text-center"
          style="background: linear-gradient(135deg, var(--color-bg-soft), var(--color-bg-elev));"
        >
          <div
            class="pointer-events-none absolute"
            style="top: -50%; left: 50%; transform: translateX(-50%); width: 600px; height: 600px; background: radial-gradient(circle, color-mix(in oklab, var(--color-rit-orange) 8%, transparent), transparent 70%);"
          >
          </div>
          <div class="relative">
            <div
              class="mb-4 text-xs tracking-[1.5px] uppercase"
              style="color: var(--color-rit-orange-text);"
            >
              Get Involved
            </div>
            <h3
              class="mx-auto mb-4 max-w-[22ch]"
              style="font-family: var(--font-display); font-size: clamp(32px, 4vw, 48px); line-height: 1.1;"
            >
              Support research that makes data trustworthy.
            </h3>
            <p class="mx-auto mb-8 max-w-[50ch] text-text-dim">
              Funding from individuals, foundations, and industry partners directly supports
              graduate stipends, equipment, and open-source releases. Every contribution compounds —
              in students trained, papers published, and tools shipped.
            </p>
            <div class="flex flex-wrap justify-center gap-[14px]">
              <a
                href="https://www.rit.edu/giving/"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full px-[22px] py-[14px] text-sm font-medium transition-transform hover:-translate-y-[1px]"
                style="background: var(--color-rit-orange); color: #0a0e13;"
              >
                Become a supporter →
              </a>
              <a
                href="mailto:lrvcs@rit.edu?subject=LDQIS%20Industry%20Partnership"
                class="inline-flex items-center gap-2 rounded-full border border-line px-[22px] py-[14px] text-sm font-medium hover:border-text-dim"
              >
                Partner with us
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  {/* FOOTER */}
  <footer class="relative z-[1] mt-20 border-t border-line pt-12 pb-8">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="flex flex-wrap items-start justify-between gap-8">
        <div>
          <div
            class="mb-3 flex items-center gap-[10px]"
            style="font-family: var(--font-display); font-size: 26px; letter-spacing: -0.5px;"
          >
            <span
              class="relative h-7 w-7 rounded-lg"
              style="background: linear-gradient(135deg, var(--color-rit-orange), var(--color-rit-yellow));"
            ></span>
            LDQIS
          </div>
          <p class="max-w-[32ch] text-[13px] text-text-dim">
            Laboratory of Data Quality and Intelligent Security at Rochester Institute of
            Technology.
          </p>
        </div>

        <div>
          <h4 class="mb-[14px] text-xs font-medium tracking-[1px] text-text-faint uppercase">
            Research
          </h4>
          <ul class="space-y-2 text-sm text-text-dim">
            <li><a href="#research" class="hover:text-rit-orange-text">Areas</a></li>
            <li><a href="#publications" class="hover:text-rit-orange-text">Publications</a></li>
            <li><a href="#projects" class="hover:text-rit-orange-text">Open-source</a></li>
          </ul>
        </div>
        <div>
          <h4 class="mb-[14px] text-xs font-medium tracking-[1px] text-text-faint uppercase">
            Lab
          </h4>
          <ul class="space-y-2 text-sm text-text-dim">
            <li><a href="#people" class="hover:text-rit-orange-text">Current team</a></li>
            <li><a href="#people" class="hover:text-rit-orange-text">Alumni</a></li>
            <li>
              <a
                href="mailto:lrvcs@rit.edu?subject=Joining%20LDQIS"
                class="hover:text-rit-orange-text">Join us</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h4 class="mb-[14px] text-xs font-medium tracking-[1px] text-text-faint uppercase">
            Contact
          </h4>
          <ul class="space-y-2 text-sm text-text-dim">
            <li>
              <a
                href="https://www.rit.edu/computing/"
                target="_blank"
                rel="noopener"
                class="hover:text-rit-orange-text">RIT GCCIS</a
              >
            </li>
            <li>
              <a href="mailto:lrvcs@rit.edu" class="hover:text-rit-orange-text">Get in touch</a>
            </li>
            <li>
              <a
                href="https://scholar.google.com/citations?user=cKqeJEgAAAAJ&hl=en"
                target="_blank"
                rel="noopener"
                class="hover:text-rit-orange-text">Google Scholar</a
              >
            </li>
          </ul>
        </div>
      </div>

      <div
        class="mt-12 flex flex-wrap justify-between gap-3 border-t border-line pt-6 text-xs text-text-faint"
      >
        <div class="flex flex-wrap items-center gap-[14px]">
          <a
            href="https://www.rit.edu"
            target="_blank"
            rel="noopener"
            aria-label="Rochester Institute of Technology"
            class="inline-flex items-center opacity-85 transition-opacity hover:opacity-100"
          >
            <img
              src="https://www.rit.edu/brandportal/sites/rit.edu.brandportal/files/2020-04/RIT_RGB_hor_full_k.png"
              alt="Rochester Institute of Technology"
              class="h-7 w-auto dark:hidden"
            />
            <img
              src="https://www.rit.edu/brandportal/sites/rit.edu.brandportal/files/2020-04/RIT_RGB_hor_full_w.png"
              alt="Rochester Institute of Technology"
              class="hidden h-7 w-auto dark:block"
            />
          </a>
          <span class="text-text-faint">·</span>
          <div>© 2026 LDQIS · A research laboratory at RIT</div>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>
