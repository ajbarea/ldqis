---
import { type GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactLinks from "../../components/ContactLinks.astro";
import Avatar from "../../components/Avatar.astro";
import Nav from "../../components/Nav.astro";

// Detail pages for people give each researcher (current + past cohort)
// a stable shareable URL. The lab's pre-M2 site had no per-person page;
// alumni had no canonical link to point at from CVs / LinkedIn.
export const getStaticPaths = (async () => {
  const people = await getCollection("people");
  return people.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const {
  initials,
  name,
  role,
  email,
  scholar,
  ieee,
  website,
  github,
  linkedin,
  youtube,
  orcid,
  avatar,
  years,
  cohort,
} = entry.data;
const cohortLabel = cohort === "current" ? "Current team" : "Past cohort";

// Cross-links are computed at build time by walking the source collections
// rather than denormalized on each person entry — one-direction storage
// (project.contributors / publication.author_ids) avoids the bidirectional-
// sync bug class. Order matches each collection's `order` field where
// declared, falling back to filesystem order otherwise.
const [allProjects, allPublications] = await Promise.all([
  getCollection("projects"),
  getCollection("publications"),
]);
const projectsContributed = allProjects
  .filter((p) => p.data.contributors.some((ref) => ref.id === entry.id))
  .sort((a, b) => a.data.order - b.data.order);
const publicationsAuthored = allPublications
  .filter((p) => p.data.author_ids.some((ref) => ref.id === entry.id))
  .sort((a, b) => a.data.order - b.data.order);
// Books lead (academic-CV convention: a monograph outweighs papers) and get a
// highlighted card; journal/conference papers follow in the Publications list.
const books = publicationsAuthored.filter((p) => p.data.venue_type === "book");
const papers = publicationsAuthored.filter((p) => p.data.venue_type !== "book");
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title={`${name} · LDQIS`}
  description={`${name} — ${role}. ${cohortLabel} member at the Laboratory of Data Quality and Intelligent Security, RIT.`}
>
  <Nav back={{ href: `${baseUrl}/#people`, label: "← All people" }} />

  <main id="main" class="relative z-[1] pt-16 pb-32">
    <article class="mx-auto max-w-[640px] px-6 text-center">
      <Avatar
        avatar={avatar}
        github={github}
        initials={initials}
        name={name}
        size={96}
        class="mx-auto mb-8"
        transitionName={`avatar-${entry.id}`}
      />

      <div class="mb-3 text-xs tracking-[1.5px] text-rit-orange-text uppercase">{cohortLabel}</div>

      <h1
        class="mb-6"
        style="font-family: var(--font-display); font-size: clamp(32px, 5vw, 48px); line-height: 1.1; letter-spacing: -1px;"
      >
        {name}
      </h1>

      <p class={`text-lg text-text-dim ${years ? "mb-2" : "mb-8"}`}>{role}</p>
      {years && <p class="mb-8 text-sm text-text-dim">{years}</p>}

      <ContactLinks
        email={email}
        scholar={scholar}
        ieee={ieee}
        website={website}
        github={github}
        linkedin={linkedin}
        youtube={youtube}
        orcid={orcid}
        name={name}
        variant="pill"
      />

      {
        books.length > 0 && (
          <section
            class="mt-16 border-t border-line pt-8 text-left"
            aria-labelledby="books-heading"
          >
            <h2
              id="books-heading"
              class="mb-4 text-xs tracking-[1.5px] text-rit-orange-text uppercase"
            >
              Books
            </h2>
            <ul class="space-y-3" role="list">
              {books.map((pub) => (
                <li>
                  <a
                    href={`${baseUrl}/publications/${pub.id}/`}
                    class="group block rounded-lg border p-4"
                    style="border-color: var(--color-rit-orange); background: color-mix(in oklab, var(--color-rit-orange) 7%, transparent);"
                  >
                    <div class="mb-1 text-xs tracking-[1px] text-rit-orange-text uppercase">
                      {pub.data.year} · {pub.data.venue}
                    </div>
                    <div class="text-base font-medium group-hover:text-rit-orange-text">
                      {pub.data.title}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        papers.length > 0 && (
          <section
            class={`${books.length ? "mt-12" : "mt-16"} border-t border-line pt-8 text-left`}
            aria-labelledby="publications-heading"
          >
            <h2
              id="publications-heading"
              class="mb-4 text-xs tracking-[1.5px] text-text-faint uppercase"
            >
              Publications
            </h2>
            <ul class="space-y-3" role="list">
              {papers.map((pub) => (
                <li>
                  <a
                    href={`${baseUrl}/publications/${pub.id}/`}
                    class="group block rounded-lg border border-line p-4 hover:border-rit-orange"
                  >
                    <div class="mb-1 text-xs tracking-[1px] text-text-faint uppercase">
                      {pub.data.year} · {pub.data.venue}
                    </div>
                    <div class="text-base text-text-dim group-hover:text-rit-orange-text">
                      {pub.data.title}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        projectsContributed.length > 0 && (
          <section
            class="mt-12 border-t border-line pt-8 text-left"
            aria-labelledby="projects-heading"
          >
            <h2
              id="projects-heading"
              class="mb-4 text-xs tracking-[1.5px] text-text-faint uppercase"
            >
              Projects
            </h2>
            <ul class="flex flex-wrap gap-3" role="list">
              {projectsContributed.map((project) => (
                <li>
                  <a
                    href={`${baseUrl}/projects/${project.id}/`}
                    class="inline-flex items-center gap-2 rounded-full border border-line px-[14px] py-[8px] text-sm hover:border-rit-orange hover:text-rit-orange-text"
                  >
                    {project.data.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </main>
</BaseLayout>
