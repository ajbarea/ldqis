---
import { CONTACT_EMAIL, footerGroups } from "../lib/site-links";

const groups = footerGroups(import.meta.env.BASE_URL);
const linkClass = "inline-block py-1 text-white underline-offset-4 hover:underline";
---

<footer id="site-footer" class="relative z-[1] bg-black text-white">
  <div class="mx-auto max-w-[1200px] px-6 py-14">
    <div class="grid gap-10 lg:grid-cols-[1.5fr_2fr]">
      <div>
        <address class="text-sm leading-relaxed text-neutral-300 not-italic">
          <p>
            <span class="text-base font-medium text-white">
              Laboratory of Data Quality and Intelligent Security
            </span>
            <br />
            <a href="https://www.rit.edu/computing/" class={linkClass}>
              Golisano College of Computing and Information Sciences
            </a>
            <br />
            Rochester Institute of Technology
            <br />
            1 Lomb Memorial Drive
            <br />
            Rochester, NY 14623
          </p>
          <p class="mt-2 flex flex-col items-start">
            <a href={`mailto:${CONTACT_EMAIL}`} class={linkClass}>
              {CONTACT_EMAIL}
            </a>
          </p>
        </address>
      </div>

      <nav aria-label="Footer" class="grid gap-10 sm:grid-cols-2 sm:items-start">
        {groups.map((g) => (
          <div>
            <h2 class="mb-4 text-xs font-medium tracking-[1px] text-neutral-300 uppercase">
              {g.heading}
            </h2>
            <ul class="space-y-1 text-sm">
              {g.links.map((l) => (
                <li>
                  <a href={l.href} class={linkClass}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <p class="mt-10 border-t border-neutral-700 pt-6 text-xs text-neutral-300">
      &copy; {new Date().getFullYear()} Laboratory of Data Quality and Intelligent Security
    </p>
  </div>
</footer>
