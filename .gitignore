# build output
dist/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# dev-runner archives (scripts/dev-runner.sh writes logs/dev-<ts>-<cmd>.log)
logs/

# environment
.env
.env.production
.env.local

# editor
.vscode/
.idea/
.DS_Store

# typechecking
*.tsbuildinfo

# test artifacts (Vitest coverage, Playwright reports, Lighthouse CI)
coverage/
playwright-report/
test-results/
.lighthouseci/

# never commit — AJ's per-repo working scratch convention
COMMITS.md

# husky internals (regenerated by prepare)
.husky/_/

# python (scripts/ intake + validation helpers)
__pycache__/
*.pyc

# local verification screenshots (root-level scratch, not site assets)
/Screenshot *.png

# source material dropped in for content extraction (papers, email exports) +
# Windows download tags; the site links out to PDFs, never stores them in-repo
*.pdf
*:Zone.Identifier
